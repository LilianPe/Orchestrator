{
  "format": 1,
  "projectId": "p",
  "ticketId": "REL-1",
  "workflows": {
    "7219429d2ffbad4b6da0499dd056956d25b2a880acf4c2c9fe6ff0dcfb330c38": {
      "version": 1,
      "tracker": {
        "kind": "linear",
        "pickup": {
          "checks": [
            "has_description",
            "not_started"
          ]
        }
      },
      "states": {
        "todo": "Todo",
        "dev": "In Progress",
        "human_review": "Human Review",
        "ai_review": "AI Review",
        "done": "Done"
      },
      "limits": {
        "parallelSessions": 3,
        "questionSessions": 2,
        "perRun": {
          "turns": 150,
          "durationMs": 5400000,
          "usd": 5
        },
        "verifyAttempts": 4,
        "ciFixAttempts": 2,
        "repeatedFailures": 3,
        "silentAfterMs": 1800000,
        "reviewRounds": 5
      },
      "workspace": {
        "setup": [],
        "portBase": 4200
      },
      "commands": [
        "retiens",
        "fais-le"
      ],
      "on": {
        "ticket.delegated": [
          {
            "when": [
              {
                "kind": "state_in",
                "values": [
                  "todo",
                  "dev"
                ]
              },
              {
                "kind": "blocked",
                "negate": true
              }
            ],
            "whenSrc": "state in [todo, dev] && !blocked",
            "run": "dev"
          }
        ],
        "status.changed": [
          {
            "from": "human_review",
            "to": "dev",
            "run": "dev-feedback"
          },
          {
            "to": "ai_review",
            "run": "review"
          }
        ],
        "session.prompted": [
          {
            "when": [
              {
                "kind": "blocked",
                "negate": false
              }
            ],
            "whenSrc": "blocked",
            "run": "dev-feedback",
            "debounceMs": 0
          },
          {
            "when": [
              {
                "kind": "state_in",
                "values": [
                  "dev",
                  "human_review"
                ]
              }
            ],
            "whenSrc": "state in [dev, human_review]",
            "run": "dev-feedback",
            "debounceMs": 180000
          }
        ],
        "session.mentioned": [
          {
            "run": "ask"
          }
        ],
        "command": [
          {
            "say": "retiens",
            "run": "remember"
          },
          {
            "say": "fais-le",
            "do": "propose_delegate"
          }
        ],
        "label.changed": [
          {
            "label": "agent:reprendre",
            "run": "dev-feedback"
          },
          {
            "label": "agent:stop",
            "do": "stop"
          }
        ],
        "session.stopped": [
          {
            "do": "stop"
          }
        ],
        "pr.checks_failed": [
          {
            "when": [
              {
                "kind": "state_in",
                "values": [
                  "human_review",
                  "ai_review"
                ]
              },
              {
                "kind": "blocked",
                "negate": true
              }
            ],
            "whenSrc": "state in [human_review, ai_review] && !blocked",
            "run": "fix-ci"
          }
        ],
        "pr.merged": [
          {
            "run": "learn",
            "move": "done",
            "do": "cleanup"
          }
        ]
      },
      "jobs": {
        "dev": {
          "name": "dev",
