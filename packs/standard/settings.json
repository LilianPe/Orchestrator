{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git fetch:*)", "Bash(git rebase:*)", "Bash(git checkout:*)",
      "Bash(git switch:*)", "Bash(git branch:*)", "Bash(git rev-parse:*)", "Bash(git merge-base:*)",
      "Bash(git merge-tree:*)", "Bash(git merge:*)", "Bash(git revert:*)", "Bash(git rev-list:*)", "Bash(git ls-remote:*)",
      "Bash(gh pr view:*)", "Bash(gh pr list:*)", "Bash(gh pr checks:*)", "Bash(gh pr diff:*)",
      "Bash(gh run view:*)", "Bash(gh run list:*)",
      "Bash(npm:*)", "Bash(npx:*)", "Bash(node:*)", "Bash(pnpm:*)", "Bash(yarn:*)",
      "Bash(uv:*)", "Bash(pytest:*)", "Bash(ruff:*)", "Bash(mypy:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(grep:*)", "Bash(rg:*)", "Bash(find:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)", "Bash(sleep:*)",
      "Bash(factory-agent:*)",
      "mcp__factory__submit_result", "mcp__factory__ask"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh run rerun:*)",
      "Bash(git push:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git * --no-verify*)",
      "Bash(*--no-verify*)",
      "Bash(git reset --hard origin:*)",
      "Bash(rm -rf /:*)",
      "Bash(curl *|*sh*)",
      "Bash(wget *|*sh*)",
      "Bash(*docker.sock*)",
      "Bash(*podman.sock*)",
      "Bash(*DOCKER_HOST*)",
      "Bash(*CONTAINER_HOST*)",
      "WebSearch",
      "Read(~/.factory/**)"
    ]
  }
}
