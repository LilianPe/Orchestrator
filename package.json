{
  "name": "factory",
  "version": "0.1.0",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "bin": {
    "factory": "bin/factory",
    "factory-agent": "bin/factory-agent"
  },
  "scripts": {
    "dev": "tsx src/cli/factory.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "test": "vitest run --project unit",
    "test:all": "vitest run",
    "test:integration": "vitest run --project integration --project scenarios-pg",
    "test:isolation": "vitest run --project isolation",
    "test:chaos": "vitest run --project chaos",
    "test:properties": "vitest run --project unit test/properties",
    "test:replay": "tsx src/cli/factory.ts replay test/replay/journals",
    "replay:record": "tsx test/replay/record.ts",
    "test:golden": "vitest run --project unit test/golden",
    "golden:record": "tsx test/golden/record.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "drizzle-orm": "^0.45.4",
    "eventsource": "^5.1.2",
    "hono": "^4.13.13",
    "minimatch": "^10.2.6",
    "node-forge": "1.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/node-forge": "1.3.14",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "graphql": "^17.0.2",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
