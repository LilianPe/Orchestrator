{
  "name": "factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "bin": {
    "factory": "bin/factory",
    "factory-agent": "bin/factory-agent"
  },
  "scripts": {
    "dev": "tsx src/cli/factory.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "test": "vitest run --project unit",
    "test:all": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:isolation": "vitest run --project isolation",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "drizzle-orm": "^0.45.4",
    "eventsource": "^5.1.2",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "graphql": "^17.0.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
